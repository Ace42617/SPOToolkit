{
  "manifest_version": 3,
  "name": "SPO Dev Toolkit",
  "version": "1.1.0.0",
  "description": "SharePoint Online toolkit with Power Apps / Dynamics Level Up tools on Power Platform sites.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "history",
    "declarativeNetRequest",
    "webNavigation",
    "downloads",
    "sidePanel",
    "contextMenus"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "view_formatter_iframe",
        "enabled": true,
        "path": "rules/view-formatter-iframe.json"
      }
    ]
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "host_permissions": [
    "*://*.sharepoint.com/*",
    "*://*.powerapps.com/*",
    "*://*.powerautomate.com/*",
    "*://*.powerplatform.com/*",
    "*://*.powerplatformusercontent.com/*",
    "*://*.dynamics.com/*",
    "*://make.powerpages.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.sharepoint.com/*"],
      "js": ["recycleBinWaitBanner.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.sharepoint.com/*"],
      "js": ["adminCenterWaitBanner.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.sharepoint.com/*"],
      "js": ["compassColumnCreator.js", "compassToolkitPanels.js", "compassUniversalSearch.js", "matrixWorkerLock.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.sharepoint.com/*"],
      "js": ["view-formatter-iframe-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.powerapps.com/*",
        "*://*.powerautomate.com/*",
        "*://*.powerplatform.com/*",
        "*://*.powerplatformusercontent.com/*",
        "*://*.dynamics.com/*",
        "*://make.powerpages.microsoft.com/*"
      ],
      "js": ["levelup/content.js", "powerAppsToolkitPopout.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "levelup/sidebar.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "exportCSV.js",
        "permissionsMatrixExport.js",
        "permissionsMatrixStyles.js",
        "matrixScanPlan.js",
        "reportListPlan.js",
        "getFields.js",
        "getSearchSchema.js",
        "getColumnCreatorContext.js",
        "createColumn.js",
        "checkListPage.js",
        "getListType.js",
        "getRefinableMappings.js",
        "getViewsData.js",
        "getPageContext.js",
        "getPageContextFull.js",
        "getPageContextJson.js",
        "getViewFormatContext.js",
        "getSiteLists.js",
        "getWebContents.js",
        "jszip.min.js",
        "jszip-preload.js",
        "jszip-restore-define.js",
        "icon.png",
        "lib/columnInternalName.mjs",
        "lib/columnFieldSchema.mjs",
        "lib/columnCreatorPanel.mjs"
      ],
      "matches": ["*://*.sharepoint.com/*"]
    },
    {
      "resources": [
        "levelup/levelup-extension.js",
        "levelup/sidebar.html",
        "levelup/sidebar.js",
        "levelup/sidebar.css",
        "levelup/spo-theme.css",
        "levelup/actions.js",
        "levelup/CustomCommandsService.js",
        "levelup/popup.html",
        "levelup/popup.js",
        "levelup/icons/*"
      ],
      "matches": [
        "*://*.powerapps.com/*",
        "*://*.powerautomate.com/*",
        "*://*.powerplatform.com/*",
        "*://*.powerplatformusercontent.com/*",
        "*://*.dynamics.com/*",
        "*://make.powerpages.microsoft.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SPO Dev Toolkit",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png"
    }
  },
  "commands": {
    "open-universal-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "Open Universal Settings Search",
      "global": true
    }
  }
}
