{
  "manifest_version": 3,
  "name": "SPO Dev Toolkit",
  "version": "1.0.5",
  "description": "Export list/library data, run reports, manage views, and quick links on SharePoint.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*.sharepoint.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.sharepoint.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["exportCSV.js","getFields.js","getSearchSchema.js","checkListPage.js","getListType.js","getRefinableMappings.js","getViewsData.js","getPageContext.js","getPageContextJson.js","jszip.min.js","jszip-preload.js","jszip-restore.js"],
      "matches": ["*://*.sharepoint.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png"
    }
  }
}
