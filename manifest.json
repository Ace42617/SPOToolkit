{
  "manifest_version": 3,
  "name": "SPO Toolkit",
  "version": "1.0.2",
  "description": "Export list/library data, run reports, manage views, and quick links on SharePoint.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*.sharepoint.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.sharepoint.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["exportCSV.js","getFields.js","getSearchSchema.js","checkListPage.js","getViewsData.js","saveView.js","jszip.min.js","jszip-preload.js","jszip-restore.js"],
      "matches": ["*://*.sharepoint.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
